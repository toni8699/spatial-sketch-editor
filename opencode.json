{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*.env.dev", "effect": "deny" },
    { "action": "edit", "resource": "*.env.dev", "effect": "deny" },
    { "action": "glob", "resource": "*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*.env.dev*", "effect": "deny" }
  ]
}
